rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // OWNERS: can do everything, including adding and removing admins.
    function isOwner() {
      return request.auth != null && request.auth.token.email in [
        'zxppez@dualmines.net'
      ];
    }

    // ADMINS: owners, plus anyone registered in the admin panel.
    function isAdmin() {
      return isOwner() || (request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // APPLICANTS: people logged in with Discord (via the Discord login Worker).
    function isApplicant() {
      return request.auth != null && request.auth.token.discord_id is string
        && request.auth.uid == 'discord:' + request.auth.token.discord_id;
    }

    function isBanned() {
      return exists(/databases/$(database)/documents/bans/$(request.auth.token.discord_id));
    }

    function formIsOpen() {
      return exists(/databases/$(database)/documents/settings/applicationForm)
        && get(/databases/$(database)/documents/settings/applicationForm).data.open == true;
    }

    match /admins/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isOwner();
    }

    // Online players, written by the Cloudflare Worker (from the DualminesStatus plugin).
    match /status/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Admin activity log. Any admin can add an entry in their own name only;
    // nobody can edit entries; only owners can read or delete them.
    match /logs/{id} {
      allow read, delete: if isOwner();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['action', 'summary', 'details', 'actor', 'actorUid', 'at'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actor == request.auth.token.email.split('@')[0]
        && request.resource.data.at == request.time
        && request.resource.data.action is string && request.resource.data.action.size() <= 40
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 480;
      allow update: if false;
    }

    match /settings/applicationForm {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/appealForm {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Appeals are only created by the Cloudflare Worker (it checks the Discord login
    // and stores the files). Players can read their own; admins can read and manage all.
    match /appeals/{id} {
      allow read: if isAdmin()
        || (isApplicant() && resource.data.discordId == request.auth.token.discord_id);
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Bans: admins manage them; a Discord user can check their own ban.
    match /bans/{discordId} {
      allow read: if isAdmin() || (isApplicant() && request.auth.token.discord_id == discordId);
      allow write: if isAdmin();
    }

    match /applications/{id} {
      // Only logged-in, non-banned Discord users, only while open,
      // and the Discord details must match the account they logged in with.
      allow create: if formIsOpen() && isApplicant() && !isBanned()
        && request.resource.data.keys().hasOnly(['answers', 'status', 'createdAt', 'uid',
             'discordId', 'discordName', 'discordDisplay', 'discordAvatar'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.discordId == request.auth.token.discord_id
        && request.resource.data.discordName == request.auth.token.discord_name
        && request.resource.data.discordDisplay == request.auth.token.discord_display
        && request.resource.data.discordAvatar == request.auth.token.discord_avatar
        && request.resource.data.answers is list
        && request.resource.data.answers.size() <= 60;

      // Admins see everything; applicants can see their own (to check their status).
      allow read: if isAdmin()
        || (isApplicant() && resource.data.discordId == request.auth.token.discord_id);
      allow update, delete: if isAdmin();
    }
  }
}
